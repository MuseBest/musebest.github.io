# EarnQuill on Apache shared hosting: serve clean URLs (no .html in the address)
RewriteEngine On
# Strip a trailing slash (except the site root) so /category/ becomes /category
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L]
# If a matching .html file exists, serve it (checked before directories,
# because each category has both a category.html file and a folder of articles)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
